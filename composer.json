{
  "name": "wexample/symfony-analytics",
  "description": "The audience of a site, counted on the server without cookies: visitors, visits, where they come from, where they are",
  "version": "2.0.0",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyAnalytics\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyAnalytics\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "doctrine/orm": "^3.0",
    "doctrine/doctrine-bundle": "^2.13 || ^3.0",
    "symfony/security-bundle": "^7.4 || ^8.0",
    "symfony/uid": "^7.4 || ^8.0",
    "wexample/php-pseudocode": ">=2.2.0",
    "wexample/symfony-api": ">=14.0.0",
    "wexample/symfony-charts": ">=3.0.0",
    "wexample/symfony-geo": ">=8.0.0",
    "wexample/symfony-helpers": ">=17.0.0",
    "wexample/symfony-pseudocode": ">=4.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}